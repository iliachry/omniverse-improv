{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Omniverse: Attach to Kit (debugpy)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 3000
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/exts/omni.improv.starter",
                    "remoteRoot": "${workspaceFolder}/exts/omni.improv.starter"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "Python: Run Standalone Physics Playground Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/usd_generators/generate_physics_playground.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Standalone Procedural Scene Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/usd_generators/generate_procedural_scene.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
