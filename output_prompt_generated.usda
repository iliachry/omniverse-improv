#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Environment"
    {
        def DomeLight "DomeLight"
        {
            color3f inputs:color = (0.85, 0.9, 1)
            float inputs:intensity = 600
        }

        def DistantLight "KeyLight"
        {
            color3f inputs:color = (1, 0.96, 0.9)
            float inputs:intensity = 3500
            float3 xformOp:rotateXYZ = (-45, 35, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Plane "GroundPlane" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double length = 3000
            rel material:binding = </World/Materials/M_Ground>
            bool physics:collisionEnabled = 1
            double width = 3000
        }
    }

    def Xform "Materials"
    {
        def Material "M_Base"
        {
            token outputs:surface.connect = </World/Materials/M_Base/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.12)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "M_Glow"
        {
            token outputs:surface.connect = </World/Materials/M_Glow/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.85, 0)
                color3f inputs:emissiveColor = (1, 0.85, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "M_Accent"
        {
            token outputs:surface.connect = </World/Materials/M_Accent/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0.8, 1)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.4
                float inputs:opacity = 1
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "M_Ground"
        {
            token outputs:surface.connect = </World/Materials/M_Ground/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.09, 0.11)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

