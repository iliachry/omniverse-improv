    def Xform "Environment"
    {
        def DomeLight "DomeLight"
        {
            color3f inputs:color = (0.9, 0.94, 1)
            float inputs:intensity = 600
        }

        def DistantLight "SunLight"
        {
            color3f inputs:color = (1, 0.98, 0.92)
            float inputs:intensity = 4500
            float3 xformOp:rotateXYZ = (-52, 35, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Plane "SiteTerrain" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Y"
            double length = 6000
            bool physics:collisionEnabled = 1
            double width = 6000
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 981
    }
}

