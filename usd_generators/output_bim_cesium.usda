        prepend apiSchemas = ["CesiumGeoreferenceAPI"]
    )
    {
        custom token cesium:georeferenceBinding = "WGS84"
        custom double cesium:height = 120
        custom double cesium:latitude = 37.9753
        custom double cesium:longitude = 23.7361
    }

