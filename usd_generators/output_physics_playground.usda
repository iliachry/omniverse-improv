#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Environment"
    {
        def DomeLight "DomeLight"
        {
            color3f inputs:color = (0.95, 0.98, 1)
            float inputs:intensity = 600
        }

        def DistantLight "SunLight"
        {
            color3f inputs:color = (1, 0.96, 0.9)
            float inputs:intensity = 3500
            float3 xformOp:rotateXYZ = (-50, 35, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Plane "GroundPlane" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double length = 3000
            rel material:binding = </World/Materials/M_Ground>
            bool physics:collisionEnabled = 1
            double width = 3000
        }
    }

    def Xform "Materials"
    {
        def Material "M_Ground"
        {
            token outputs:surface.connect = </World/Materials/M_Ground/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.16, 0.18)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "M_Ramp"
        {
            token outputs:surface.connect = </World/Materials/M_Ramp/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.4, 0.8)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.2
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "M_TriggerBall"
        {
            token outputs:surface.connect = </World/Materials/M_TriggerBall/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.2, 0.1)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.9
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "M_Domino"
        {
            token outputs:surface.connect = </World/Materials/M_Domino/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0.85, 0.7)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.1
                float inputs:opacity = 1
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "M_TargetBox"
        {
            token outputs:surface.connect = </World/Materials/M_TargetBox/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.7, 0.1)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }
    }

