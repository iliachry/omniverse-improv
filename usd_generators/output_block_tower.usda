#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 981
    }

    def "Environment"
    {
        def Plane "GroundPlane" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double length = 4000
            rel material:binding = </World/Materials/M_StudioGround>
            bool physics:collisionEnabled = 1
            double width = 4000
        }

        def Xform "Lights"
        {
            def DomeLight "DomeLight"
            {
                color3f inputs:color = (0.9, 0.95, 1)
                float inputs:intensity = 800
            }

            def DistantLight "KeyLight"
            {
                color3f inputs:color = (1, 0.95, 0.88)
                float inputs:intensity = 3500
                float3 xformOp:rotateXYZ = (-45, 35, 0)
                uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
            }

            def DistantLight "FillLight"
            {
                color3f inputs:color = (0.7, 0.85, 1)
                float inputs:intensity = 1200
                float3 xformOp:rotateXYZ = (-30, -145, 0)
                uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
            }
        }
    }

    def "Materials"
    {
        def Material "M_StudioGround"
        {
            token outputs:surface.connect = </World/Materials/M_StudioGround/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.13, 0.15)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0.1
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "M_WoodBlock"
        {
            token outputs:surface.connect = </World/Materials/M_WoodBlock/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.65, 0.45)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "M_neon_magenta"
        {
            token outputs:surface.connect = </World/Materials/M_neon_magenta/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0.8)
                color3f inputs:emissiveColor = (1, 0, 0.8)
                float inputs:metallic = 0.2
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "M_neon_cyan"
        {
            token outputs:surface.connect = </World/Materials/M_neon_cyan/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0.8, 1)
                color3f inputs:emissiveColor = (0, 0.9, 1)
                float inputs:metallic = 0.2
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }
    }

