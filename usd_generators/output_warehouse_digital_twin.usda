#usda 1.0
(
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Environment"
    {
        def DomeLight "DomeLight"
        {
            color3f inputs:color = (0.88, 0.92, 1)
            float inputs:intensity = 400
        }

        def DistantLight "CeilingFlood"
        {
            color3f inputs:color = (1, 0.96, 0.9)
            float inputs:intensity = 3800
            float3 xformOp:rotateXYZ = (-65, 30, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Plane "GroundPlane" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Y"
            double length = 4000
            rel material:binding = </World/Materials/M_ConcreteFloor>
            bool physics:collisionEnabled = 1
            double width = 4000
        }
    }

    def Xform "Materials"
    {
        def Material "M_ConcreteFloor"
        {
            token outputs:surface.connect = </World/Materials/M_ConcreteFloor/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.14, 0.15, 0.17)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "M_SteelBlue"
        {
            token outputs:surface.connect = </World/Materials/M_SteelBlue/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.22, 0.45)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.7
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "M_SafetyOrange"
        {
            token outputs:surface.connect = </World/Materials/M_SafetyOrange/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.38, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.3
                float inputs:opacity = 1
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "M_WoodPallet"
        {
            token outputs:surface.connect = </World/Materials/M_WoodPallet/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.48, 0.32)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "M_Cardboard"
        {
            token outputs:surface.connect = </World/Materials/M_Cardboard/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.62, 0.42)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "M_RubberBelt"
        {
            token outputs:surface.connect = </World/Materials/M_RubberBelt/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.1
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "M_HazardYellow"
        {
            token outputs:surface.connect = </World/Materials/M_HazardYellow/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.78, 0.05)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.1
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

