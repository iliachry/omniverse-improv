    def Xform "Environment"
    {
        def DomeLight "DomeLight"
        {
            color3f inputs:color = (0.1, 0.15, 0.25)
            float inputs:intensity = 200
        }

        def DistantLight "KeyLight"
        {
            color3f inputs:color = (1, 0.85, 0.7)
            float inputs:intensity = 2500
            float3 xformOp:rotateXYZ = (-40, 45, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DistantLight "RimLight"
        {
            color3f inputs:color = (0, 0.7, 1)
            float inputs:intensity = 3500
            float3 xformOp:rotateXYZ = (-20, -135, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

