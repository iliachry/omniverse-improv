    def Xform "Materials"
    {
        def Material "M_FloorMetal"
        {
            token outputs:surface.connect = </World/Materials/M_FloorMetal/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.11, 0.13)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.9
                float inputs:opacity = 1
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "M_DarkPanel"
        {
            token outputs:surface.connect = </World/Materials/M_DarkPanel/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.04, 0.05)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.1
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "M_GoldTrim"
        {
            token outputs:surface.connect = </World/Materials/M_GoldTrim/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.78, 0.35)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "M_NeonCyan"
        {
            token outputs:surface.connect = </World/Materials/M_NeonCyan/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0.9, 1)
                color3f inputs:emissiveColor = (0, 0.95, 1)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "M_NeonOrange"
        {
            token outputs:surface.connect = </World/Materials/M_NeonOrange/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.4, 0)
                color3f inputs:emissiveColor = (1, 0.45, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "M_CoreGem"
        {
            token outputs:surface.connect = </World/Materials/M_CoreGem/PBRShader.outputs:surface>

            def Shader "PBRShader"
